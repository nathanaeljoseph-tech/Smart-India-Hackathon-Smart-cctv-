*.pyc
*.pyo
*.pyd

# --- Logs ---
*.log

# --- Training run artifacts ---
runs/

# --- OS junk ---
.DS_Store
Thumbs.db

# --- IDE/editor files ---
.vscode/
.idea/
*.swp
